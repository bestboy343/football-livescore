"use client";
import { useState } from "react";

const matches = [
  { id: 1, league: "WORLD • Friendly • 12:00", home: "Colombia", away: "Peru", score: "0-0", status: "FT" },
  { id: 2, league: "WORLD • Friendly • 14:00", home: "Argentina", away: "Benin", score: "0-0", status: "FT" },
  { id: 3, league: "BRAZIL • Serie B • Live", home: "Goias", away: "Athletic", score: "LIVE", status: "LIVE" },
  { id: 4, league: "ALGERIA • Ligue 1 • 16:30", home: "Saoura", away: "Khenchela", score: "0-0", status: "FT" },
];

export default function Page() {
  const [active, setActive] = useState("Today");
  const [filter, setFilter] = useState("All");
  const [data, setData] = useState(matches);
  const [loading, setLoading] = useState(false);

  const handleRefresh = () => {
    setLoading(true);
    setTimeout(() => {
      setLoading(false);
      // here you call your real API
      // fetchLiveScores()
    }, 800);
  };

  return (
    <div className="min-h-screen bg-[#0a1220] text-white">
      {/* HEADER */}
      <div className="text-center py-4 font-bold text-lg tracking-wide border-b-2 border-[#00bfff]">
        BESTSCORE • {data.length} MATCHES
      </div>

      {/* FILTERS */}
      <div className="p-3 bg-[#0f1c30] flex flex-wrap gap-2">
        {["Today", "Yesterday", "Tomorrow", "All", "LIVE", "FT"].map((tab) => (
          <button
            key={tab}
            onClick={() => {
              if (tab === "LIVE" || tab === "FT") setFilter(tab);
              else { setActive(tab); setFilter("All"); }
            }}
            className={`px-5 py-2.5 rounded-xl font-bold text-sm transition-all
              ${(active === tab || filter === tab) 
                ? "bg-[#00bfff] text-black" 
                : "bg-[#1a2a44] text-[#7a8aa8]"}`}
          >
            {tab}
          </button>
        ))}
        <button
          onClick={handleRefresh}
          className="ml-auto px-5 py-2.5 rounded-xl font-bold text-sm bg-[#00bfff] text-black hover:bg-[#00a0d6]"
        >
          {loading ? "..." : "REFRESH"}
        </button>
      </div>

      {/* MATCH LIST */}
      <div className="p-2 space-y-2">
        {data.map((m) => (
          <div key={m.id} className="bg-[#13233d] rounded-xl p-3 flex justify-between items-center">
            <div>
              <div className="text-[11px] text-[#5a7a9c] font-bold mb-1">{m.league}</div>
              <div className="font-bold text-[17px]">
                {m.home} <span className="text-[#5a7a9c] font-normal">vs</span> {m.away}
              </div>
            </div>
            <div className={`px-3 py-1.5 rounded-lg font-black text-sm
              ${m.score === "LIVE" ? "bg-red-600 text-white" : "bg-[#0f2a4a] text-[#00bfff]"}`}>
              {m.score}
            </div>
          </div>
        ))}
      </div>

      <div className="text-center text-[#2a3a54] text-sm mt-6">Today • {filter}</div>
    </div>
  );
}
